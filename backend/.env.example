PORT=5000
# On Windows, run `npm run db:local-replica` once before starting the backend.
# It copies a local 27017 standalone cafe database on first run, then updates backend/.env.
# For a fresh install, use a replica set or MongoDB Atlas URI here.
MONGO_URI=mongodb://127.0.0.1:27019/aura_cafe_erp?replicaSet=auraCafeLocal
# Set a strong, private value for deployment. Local development generates one.
# JWT_SECRET=

# Password-recovery OTP email. Supply your own SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
# Compatible with the existing SWP391 configuration:
# AURA_SMTP_EMAIL=
# AURA_SMTP_PASSWORD=

# SePay bank-transfer webhook: configure JSON, incoming transfers, API Key auth.
# Public webhook URL: https://YOUR-BACKEND/api/payments/sepay-webhook
# Add payment-code prefix AU, 24-character alphanumeric suffix in SePay. Keep the API key private.
SEPAY_WEBHOOK_API_KEY=
PAYMENT_DEMO_ENABLED=false
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
