PORT=5000
# On Windows, run `npm run db:local-replica` once before starting the backend.
# It copies a local 27017 standalone cafe database on first run, then updates backend/.env.
# For a fresh install, use a replica set or MongoDB Atlas URI here.
MONGO_URI=mongodb://127.0.0.1:27019/aura_cafe_erp?replicaSet=auraCafeLocal
# Set a strong, private value for deployment. Local development generates one.
# JWT_SECRET=

# Password-recovery OTP email. Supply your own SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
# Compatible with the existing SWP391 configuration:
# AURA_SMTP_EMAIL=
# AURA_SMTP_PASSWORD=

# Optional gateway compatible with SWP PaymentService (HMAC SHA-256).
# Configure its callback URL as <backend-public-url>/api/payments/callback.
PAYMENT_GATEWAY_URL=
PAYMENT_CALLBACK_SECRET=
PAYMENT_APP_ID=aura_cafe
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=

# Local mock only: set PAYMENT_GATEWAY_URL=http://127.0.0.1:5050 and run npm run mock:gateway.
# The mock simulates a signed callback and does not transfer money.
# MOCK_GATEWAY_PORT=5050
# MOCK_BACKEND_URL=http://127.0.0.1:5000
