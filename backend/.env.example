PORT=5000
# Use an existing replica set or MongoDB Atlas for atomic business writes.
# Example only: do not replace the real URI without backing up your database.
MONGO_URI=mongodb://127.0.0.1:27017/aura_cafe_erp?replicaSet=rs0
# Set a strong, private value for deployment. Local development generates one.
# JWT_SECRET=

# Password-recovery OTP email. Supply your own SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# Optional gateway compatible with SWP PaymentService (HMAC SHA-256).
# Configure its callback URL as <backend-public-url>/api/payments/callback.
PAYMENT_GATEWAY_URL=
PAYMENT_CALLBACK_SECRET=
PAYMENT_APP_ID=aura_cafe
PAYMENT_BANK_ID=
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
