PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/aura_cafe_erp?replicaSet=rs0

# Local JWT signing uses backend/.jwt-secret. Set JWT_SECRET for deployment.
# JWT_SECRET=

# Gmail OTP. Existing AURA_SMTP_EMAIL / AURA_SMTP_PASSWORD below remain active.
# Empty SMTP_FROM, SMTP_USER and SMTP_PASS use those existing credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# Bank information used by the QR payment screen.
PAYMENT_APP_ID=aura_cafe
PAYMENT_BANK_ID=BIDV
PAYMENT_BANK_NAME=BIDV
PAYMENT_ACCOUNT_NO=9624742352
PAYMENT_ACCOUNT_NAME=PHAM VAN HOANG NGOC

# Signed payment gateway: configure both values for a compatible gateway.
PAYMENT_GATEWAY_URL=
PAYMENT_CALLBACK_SECRET=

# Optional local mock: set PAYMENT_GATEWAY_URL=http://127.0.0.1:5050,
# set a private PAYMENT_CALLBACK_SECRET (16+ characters), then npm run mock:gateway.
MOCK_GATEWAY_PORT=5050
MOCK_BACKEND_URL=http://127.0.0.1:5000

